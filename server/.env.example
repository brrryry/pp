# Application Environment & Server Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Database & Cache Service URLs
DATABASE_URL=postgresql://ppuser:pppassword@postgres:5432/ppdb
REDIS_URL=redis://redis:6379/0
SQLITE_DB_PATH=data/pp.db

# osu! API v2 Credentials
OSU_API_CLIENT_ID=21492
OSU_API_CLIENT_SECRET=your_client_secret_here
OSU_API_REDIRECT_URI=http://localhost:4000

# File Storage & Model Weights Paths
MAPS_PATH=data/maps
REPLAYS_PATH=data/replays
LOG_PATH=data/logs
EMBEDDER_FILE_PATH=embedder/best_vae_contrastive.pth
RECOMMENDATION_ENGINE_FOLDER=models

# Neural Network Model Hyperparameters
INPUT_SIZE=13
HIDDEN_SIZE=128
EMBEDDING_SIZE=128
DROPOUT=0.2
BATCH_SIZE=32
EPOCHS=10
LEARNING_RATE=0.001
