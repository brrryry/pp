# Virtual Environments
.venv/
.venv*/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Node.js / React Frontend
node_modules/
frontend/node_modules/
.eslintcache
.vite-inspect

# Vite / Frontend Build Outputs (Generated by npm run build)
# Comment this out if you prefer to commit compiled assets to Git
/static/assets/
/static/index.html

# Local Database & User Telemetry
# Exclude database files as they can be very large and contain local cache data
*.db
*.db-journal
*.db-wal
*.sqlite3
data/test_osu_profiler.db
server/data/test_osu_profiler.db
data/osu_profiler.db
server/data/osu_profiler.db

# Large Beatmap & Replay Data Directories
# Beatmaps and replays should be downloaded/ingested locally on-demand
data/maps/
server/data/maps/
data/replays/
server/data/replays/

# Model Artifacts (Trained weights & predictors)
# Comment this out if you want to sync your trained models via Git
data/model_results/
server/data/model_results/

# Log Directories
*.log
data/logs/
server/data/logs/

# OS-Specific Files
.DS_Store
Thumbs.db
desktop.ini

.vscode/*
